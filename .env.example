# Copy to .env.local and fill in real values. Never commit .env.local.
# Add the same variables in Vercel → Project Settings → Environment Variables.

# ── Supabase (public — safe to expose to the browser) ─────────────────────────
# Hosted: Supabase Dashboard → Project Settings → API (use the PUBLISHABLE key).
# Local:  http://127.0.0.1:54321 after `supabase start` (see README).
# When both are set, the online enquiry form is enabled. Set before building.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only secrets ──────────────────────────────────────────────────────
# None yet. The app never uses the Supabase secret / service_role key.
# When added (e.g. Resend API key for enquiry emails), they must NOT use the
# NEXT_PUBLIC_ prefix, and Edge Function secrets belong in Supabase
# (`supabase secrets set`), not in this file.
