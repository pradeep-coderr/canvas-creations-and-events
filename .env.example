# Copy to .env.local and fill in real values. Never commit .env.local.
# Add the same variables in Vercel → Project Settings → Environment Variables.

# ── Site URL (public) ─────────────────────────────────────────────────────────
# Canonical origin for SEO metadata, robots.txt and sitemap.xml, e.g.
# https://your-domain.com.au (no trailing path). If unset, Vercel's production
# domain is used, then http://localhost:3000. Set before building.
NEXT_PUBLIC_SITE_URL=

# ── Supabase (public — safe to expose to the browser) ─────────────────────────
# Hosted: Supabase Dashboard → Project Settings → API (use the PUBLISHABLE key).
# Local:  http://127.0.0.1:54321 after `supabase start` (see README).
# When both are set, the online enquiry form is enabled. Set before building.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only secrets ──────────────────────────────────────────────────────
# Never prefix these with NEXT_PUBLIC_. The app never uses the Supabase
# secret / service_role key.

# Enquiry notification emails (Resend). Leave all three empty to run without
# email: enquiries are still stored, and the server logs that the
# notification was skipped.
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender — must be valid for your Resend account (a domain you've verified
# in Resend). Example format: Canvas Creations <enquiries@your-domain>
RESEND_FROM_EMAIL=
# Who receives new-enquiry notifications (comma-separate several addresses).
ENQUIRY_NOTIFICATION_EMAIL=
