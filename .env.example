# Copy to .env.local and fill in real values. Never commit .env.local.
# Add the same variables in Vercel → Project Settings → Environment Variables.

# ── Supabase (public — safe to expose to the browser) ─────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only secrets ──────────────────────────────────────────────────────
# None yet. When added (e.g. Resend API key for the enquiry email), they must
# NOT use the NEXT_PUBLIC_ prefix, and Edge Function secrets belong in
# Supabase (`supabase secrets set`), not in this file.
