# Copy to .env.local and fill in the values:   cp .env.example .env.local
# Never commit .env.local. Production values live in Vercel → Project →
# Settings → Environment Variables (same names). Restart `bun run dev` after
# changing this file; NEXT_PUBLIC_* values are baked in at build time.
#
# LOCAL TESTING (recommended): point at the LOCAL Supabase, not the live one,
# so test enquiries, reviews and notification devices never touch real data.
#   1. bunx supabase start                 (Docker must be running)
#   2. fill in the values below
#   3. bun run setup:local -- --keys       (prints push keys + secret to paste)
#   4. bun run setup:local                 (stores the push secret in the LOCAL db)
#   5. bun run setup:local -- --admin you@example.com   (creates/makes that local user a super admin)
# Full guide: README → "Local email & push testing".

# ── Site address (public) ─────────────────────────────────────────────────────
# Used for Google details, the sitemap and links in emails.
#   Local:      http://localhost:3000
#   Production: https://www.canvascreation.com.au (optional on Vercel: its
#               production domain is used automatically when this is empty)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (public — safe in the browser) ──────────────────────────────────
# Local:  after `bunx supabase start`, run `bunx supabase status`:
#           API URL          → NEXT_PUBLIC_SUPABASE_URL (http://127.0.0.1:54321)
#           Publishable key  → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_…)
# Live:   Supabase dashboard → Project Settings → API Keys → "Publishable key"
#         (never the secret / service_role key — the app doesn't use it).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Email: enquiry & review notifications (Resend) — server only ─────────────
# Leave all three empty to run without email (everything is still saved).
#
# RESEND_API_KEY: https://resend.com → API Keys → Create API key
#   (permission "Sending access" is enough). Starts with re_…
#   Use a separate key for local and for Vercel, so either can be revoked.
RESEND_API_KEY=
# RESEND_FROM_EMAIL: the sender.
#   Before your domain is verified in Resend (testing):
#     Canvas Creations <onboarding@resend.dev>
#     (Resend then only delivers to the email address you signed up to Resend with.)
#   After verifying canvascreation.com.au in Resend → Domains (DNS records at GoDaddy):
#     Canvas Creations <enquiries@canvascreation.com.au>
RESEND_FROM_EMAIL=Canvas Creations <onboarding@resend.dev>
# ENQUIRY_NOTIFICATION_EMAIL: who receives the notifications (comma-separate
#   several). While testing with onboarding@resend.dev it must be your Resend
#   login email. Live: e.g. ccandevents2242@gmail.com
ENQUIRY_NOTIFICATION_EMAIL=

# ── Push notifications for admins (Web Push / VAPID) — keys are per place ────
# Leave all four empty to run without push (Settings says it isn't set up).
# Generate ALL of these with:   bun run setup:local -- --keys
#   (or keys only: bunx web-push generate-vapid-keys)
# Use a DIFFERENT pair locally and on Vercel. If the live pair ever changes,
# every admin device must turn notifications on again.
#
# Public key (safe in the browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key — server only, never share.
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto: + an email you read.
VAPID_SUBJECT=mailto:ccandevents2242@gmail.com
# Random secret (32+ characters) shared with the database, which uses it to
# ask the site to send calendar reminders. The database must hold the SAME
# value: locally `bun run setup:local` stores it; live it's in
# private.app_config (key push_dispatch_secret).
PUSH_DISPATCH_SECRET=

# ── Optional: uploaded videos (Cloudflare Stream) ─────────────────────────────
# Only if films are uploaded to Cloudflare Stream rather than YouTube/Vimeo:
# Cloudflare dashboard → Stream → the "customer-XXXX" part of a video's URL.
VIDEO_STREAM_CUSTOMER_CODE=
